{
  "name": "nql-insight",
  "version": "0.1.0",
  "private": true,
  "description": "NQL Insight - enterprise natural language analytics over PostgreSQL with a governed semantic layer.",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "overrides": {
    "postcss": "^8.5.23"
  },
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "start": "npm run start --workspace apps/web",
    "lint": "npm run lint --workspace apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace apps/web",
    "test:e2e": "npm run test:e2e --workspace apps/web"
  }
}
