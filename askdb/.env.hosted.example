# Ask DB — this laptop + Supabase. Start: .\scripts\dev.ps1 -Profile hosted
# Do not paste this file into Render. Copy .env.render.example → .env.render

ENVIRONMENT=development
AUTH_BYPASS=false
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=localhost,127.0.0.1

APP_DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require
AUTOMOTIVE_DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require
INSURANCE_DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require
AUTOMOTIVE_MIGRATE_DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require
INSURANCE_MIGRATE_DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require

DEFAULT_INDUSTRY=automotive
JWT_SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars

LLM_API_KEY=
LLM_BASE_URL=https://openai.generative.engine.capgemini.com/v1
LLM_DEFAULT_MODEL=openai.gpt-5.1
LLM_TEMPERATURE=0.2
LLM_MAX_COMPLETION_TOKENS=600
LLM_TIMEOUT_SECONDS=55
