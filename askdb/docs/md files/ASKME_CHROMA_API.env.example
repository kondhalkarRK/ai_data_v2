# AskMe API configuration - SANITIZED TEMPLATE, not an active .env.
# Copy/merge into the root .env or apps/api/.env after filling placeholders.
# Never overwrite working database/JWT/provider values with placeholders.
# Existing unrelated feature flags are retained from the supplied configuration.
# Process environment overrides files; apps/api/.env overrides root .env.

ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14
JWT_ISSUER=nql-insight
JWT_AUDIENCE=nql-insight-web
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CSRF_HEADER_NAME=x-csrf-token
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=120
AUTH_BYPASS=false
DEFAULT_INDUSTRY=insurance
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_CONNECT_TIMEOUT_SECONDS=10
SQL_STATEMENT_TIMEOUT_SECONDS=30
SQL_MAX_RESULT_ROWS=1000
SQL_PREVIEW_PAGE_SIZE=50
LLM_DEFAULT_MODEL=anthropic.claude-opus-5
LLM_TEMPERATURE=0.2
LLM_MAX_COMPLETION_TOKENS=6000
LLM_TIMEOUT_SECONDS=55
CHAT_ROUTER_ENABLED=true
CHAT_FOLLOW_UP_GUARD_ENABLED=true
CHAT_QUESTION_REWRITES_ENABLED=true
CHAT_STRUCTURED_CLASSIFIER_ENABLED=false
CHAT_GENERAL_KNOWLEDGE_ENABLED=true
ASK_ME_NEW_CHAT_UI_ENABLED=true
ASK_ME_AUGMENTED_DASHBOARD_ENABLED=true
ASK_ME_ASKWIZ_ENABLED=true
ASKWIZ_TIMEZONE=Asia/Kolkata
ASKWIZ_RUN_TIMEOUT_SECONDS=20
ASK_ME_ANALYTICS_WORKSPACE_ENABLED=true
ASK_ME_ASKBI_ENABLED=true
ASK_ME_ASKBI_ADVANCED_ENABLED=true

# Authentication: reuse your CURRENT private JWT secret to preserve sessions.
JWT_SECRET_KEY=REPLACE_WITH_YOUR_EXISTING_PRIVATE_JWT_SECRET
# Development browser settings; preserve approved deployment values if different.
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1

# Database URLs: retain your CURRENT working private connection strings.
# URL-encode special characters in database usernames/passwords.
APP_DATABASE_URL=postgresql+psycopg://APP_USER:APP_PASSWORD@APP_HOST:5432/APP_DATABASE
AUTOMOTIVE_DATABASE_URL=postgresql+psycopg://READONLY_USER:READONLY_PASSWORD@AUTO_HOST:5432/AUTO_DATABASE
INSURANCE_DATABASE_URL=postgresql+psycopg://READONLY_USER:READONLY_PASSWORD@INSURANCE_HOST:5432/INSURANCE_DATABASE
AUTOMOTIVE_MIGRATE_DATABASE_URL=postgresql+psycopg://OWNER_USER:OWNER_PASSWORD@AUTO_HOST:5432/AUTO_DATABASE
INSURANCE_MIGRATE_DATABASE_URL=postgresql+psycopg://OWNER_USER:OWNER_PASSWORD@INSURANCE_HOST:5432/INSURANCE_DATABASE

# Existing narration/chat service: retain your current approved gateway and model.
LLM_BASE_URL=https://REPLACE_WITH_YOUR_CURRENT_APPROVED_LLM_GATEWAY/v1
LLM_API_KEY=REPLACE_WITH_YOUR_CURRENT_LLM_API_KEY
# Optional separate Anthropic configuration. Keep empty unless actually used.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# Chroma document RAG.
# Keep OFF until the approved embedding model/URL/key below are available.
# Then change ONLY this flag to true and restart the API for the pilot.
ASK_ME_RAG_ENABLED=false
RAG_VECTOR_BACKEND=chroma
# Example folders: change to approved writable absolute folders outside OneDrive.
RAG_CHROMA_PATH=C:/AskMeData/chroma
RAG_STORAGE_BACKEND=local
RAG_STORAGE_ROOT=C:/AskMeData/documents
RAG_MIN_SIMILARITY=0.25
RAG_RETAIN_DELETED_FILES=true

UPLOAD_MAX_BYTES=26214400
UPLOAD_ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.md,.html
RAG_CHUNK_MAX_CHARS=1400
RAG_CHUNK_MIN_CHARS=40
RAG_CHUNK_OVERLAP_CHARS=180
RAG_TOP_K=6

# Embeddings are a DIFFERENT capability from chat completions.
# AskMe appends /embeddings to BASE_URL; do not append /embeddings yourself.
# Configure an approved OpenAI-compatible endpoint, NOT an arbitrary chat model.
RAG_EMBEDDING_PROVIDER=openai_compatible
RAG_EMBEDDING_BASE_URL=https://REPLACE_WITH_APPROVED_EMBEDDING_GATEWAY/v1
RAG_EMBEDDING_MODEL=REPLACE_WITH_APPROVED_EMBEDDING_MODEL_ID
RAG_EMBEDDING_API_KEY=REPLACE_WITH_EMBEDDING_API_KEY
RAG_EMBEDDING_DIMENSION=0
RAG_EMBEDDING_BATCH_SIZE=32

# One backend process, only its in-process ingestion worker for embedded Chroma.
RAG_WORKER_IN_PROCESS=true
RAG_WORKER_POLL_SECONDS=2
RAG_JOB_LEASE_SECONDS=120
RAG_JOB_MAX_ATTEMPTS=5
RAG_JOB_BACKOFF_SECONDS=15

# Legacy Qdrant/Mongo/EMBEDDINGS_* entries were omitted from this Chroma template.
# Do not uninstall or delete existing stores; retain private rollback config.
# No QDRANT_URL, QDRANT_API_KEY or RAG_QDRANT_* values are needed for Chroma.

# Web retrieval is independent from uploaded-document retrieval.
WEB_RETRIEVAL_ENABLED=false
WEB_RETRIEVAL_ALLOWLIST=
WEB_RETRIEVAL_TIMEOUT_SECONDS=8
WEB_RETRIEVAL_MAX_BYTES=2097152

# Keep certificate verification enabled. If IT supplies a company CA bundle:
SSL_VERIFY=true
SSL_CERT_FILE=
