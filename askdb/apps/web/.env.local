# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_APP_NAME=NQL Insight
# NEXT_PUBLIC_AUTH_BYPASS=false
# API_REWRITE_TARGET=http://localhost:8000

# # Classic | New toggle on /chat (restart npm run dev after changing)
# ASK_ME_NEW_CHAT_UI_ENABLED=true
# # Compile the automotive Custom Report / Auto Report · AskBI experience.
# NEXT_PUBLIC_ASK_ME_ASKBI_ENABLED=true


# AskMe frontend - copy/merge into apps/web/.env.local.
# Public settings only. NEVER add database passwords or provider API keys here.
# Local development: browser uses same-origin proxy routes.
NEXT_PUBLIC_API_BASE_URL=
API_REWRITE_TARGET=http://localhost:8000
NEXT_PUBLIC_APP_NAME=AskMe
NEXT_PUBLIC_AUTH_BYPASS=false
NEXT_PUBLIC_ASK_ME_NEW_CHAT_UI_ENABLED=true
NEXT_PUBLIC_ASK_ME_AUGMENTED_DASHBOARD_ENABLED=true
NEXT_PUBLIC_ASK_ME_ASKWIZ_ENABLED=true
NEXT_PUBLIC_ASK_ME_ANALYTICS_WORKSPACE_ENABLED=true
NEXT_PUBLIC_ASK_ME_ASKBI_ENABLED=true

# No frontend RAG key/endpoint needed. The chat switch sends useDocuments.